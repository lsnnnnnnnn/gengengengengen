# HEX values follow the user-supplied palette. Pair colors with markers/linestyles.
axes.prop_cycle: cycler('color', ['B6B3D6', 'E9687A', 'F8B2A2', 'CFCCE3', 'F1837A', 'D5D3DE', 'F6DFD6', 'D5D1D1'])
figure.facecolor: white
axes.facecolor: white
text.color: .15
axes.labelcolor: .15
xtick.color: .15
ytick.color: .15
axes.edgecolor: .3
axes.spines.top: False
axes.spines.right: False
axes.grid: False
font.size: 10
axes.labelsize: 10
xtick.labelsize: 9
ytick.labelsize: 9
legend.fontsize: 9
legend.frameon: False
lines.linewidth: 1.8
lines.markersize: 5
savefig.dpi: 300
savefig.bbox: tight
pdf.fonttype: 42
ps.fonttype: 42
